# Copie para .env e troque os valores. O arquivo .env nunca é versionado.
MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=docegestao
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/docegestao?useSSL=false&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=troque-esta-senha
# Gere com: openssl rand -base64 64
JWT_SECRET=gere-um-segredo-forte-aqui
JWT_EXPIRATION_MS=86400000
